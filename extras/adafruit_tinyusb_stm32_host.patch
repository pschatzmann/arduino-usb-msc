diff --git a/src/arduino/cdc/Adafruit_USBH_CDC.cpp b/src/arduino/cdc/Adafruit_USBH_CDC.cpp
index 1fcafb27..545cdee8 100644
--- a/src/arduino/cdc/Adafruit_USBH_CDC.cpp
+++ b/src/arduino/cdc/Adafruit_USBH_CDC.cpp
@@ -29,7 +29,12 @@
 
 #include "tusb_option.h"
 
-#if CFG_TUH_ENABLED && CFG_TUH_MSC
+// Was "&& CFG_TUH_MSC" -- this file only uses tuh_cdc_* APIs, which only
+// exist when CFG_TUH_CDC is on; MSC has nothing to do with it. That
+// mismatch was harmless while every port always set both together, but
+// broke STM32 host support (usb-host-msc enables MSC without CDC, since
+// this class's default HardwareSerial() base isn't available there).
+#if CFG_TUH_ENABLED && CFG_TUH_CDC
 
 #include "tusb.h"
 
diff --git a/src/arduino/ports/stm32/Adafruit_TinyUSB_stm32.cpp b/src/arduino/ports/stm32/Adafruit_TinyUSB_stm32.cpp
index 399f2bcb..e296ec2e 100644
--- a/src/arduino/ports/stm32/Adafruit_TinyUSB_stm32.cpp
+++ b/src/arduino/ports/stm32/Adafruit_TinyUSB_stm32.cpp
@@ -100,6 +100,20 @@
 
 #endif // !STM32WBxx || STM32WBAxx
 
+// The "Serial" global (== SerialTinyUSB, a device-mode CDC-ACM instance)
+// always exists on this core regardless of CFG_TUH_ENABLED, so its glue
+// (Adafruit_USBD_CDC.cpp) is always compiled and calls
+// TinyUSB_Port_EnterDFU()/TinyUSB_Port_GetSerialNumber() from callbacks
+// TinyUSB's core invokes directly -- those two stay defined unconditionally,
+// further down. Everything else below actually claims the OTG peripheral
+// for device role (ISR, TinyUSB_Port_InitDevice) or assumes it's safe to
+// pump tud_task() (yield()/serialEventRun()), so it has to stay out of the
+// build when CFG_TUH_ENABLED claims that same peripheral for host role
+// instead (see usb-host-msc's STM32 port) -- most importantly, so its
+// OTG_FS/HS interrupt vector definition doesn't collide with the host
+// port's.
+#if !CFG_TUH_ENABLED
+
 //--------------------------------------------------------------------+
 // Forward USB interrupt events to TinyUSB IRQ Handler
 //--------------------------------------------------------------------+
@@ -267,6 +281,8 @@ void TinyUSB_Port_InitDevice(uint8_t rhport) {
   tusb_init(rhport, &rh_init);
 }
 
+#endif // !CFG_TUH_ENABLED
+
 void TinyUSB_Port_EnterDFU(void) {
   // Optional - implement bootloader entry if needed
 }
diff --git a/src/arduino/ports/stm32/tusb_config_stm32.h b/src/arduino/ports/stm32/tusb_config_stm32.h
index ef15c845..54cb8a60 100644
--- a/src/arduino/ports/stm32/tusb_config_stm32.h
+++ b/src/arduino/ports/stm32/tusb_config_stm32.h
@@ -84,6 +84,30 @@
 //--------------------------------------------------------------------
 // Host Configuration
 //--------------------------------------------------------------------
-#define CFG_TUH_ENABLED 0 // disable for now
+// Unsupported/untested upstream (hence the #ifndef rather than a plain
+// #define): opt in per-build with -DCFG_TUH_ENABLED=1 (see
+// https://github.com/pschatzmann/usb-host-msc). Left off by default so
+// every other STM32 sketch using this library keeps working unchanged.
+#ifndef CFG_TUH_ENABLED
+#define CFG_TUH_ENABLED 0
+#endif
+
+#if CFG_TUH_ENABLED
+
+#define CFG_TUH_MAX_SPEED OPT_MODE_FULL_SPEED
+#define CFG_TUH_ENUMERATION_BUFSIZE 256
+
+#define CFG_TUH_HUB 1
+#define CFG_TUH_DEVICE_MAX (3 * CFG_TUH_HUB + 1)
+
+#define CFG_TUH_MSC 1
+#define CFG_TUH_HID (3 * CFG_TUH_DEVICE_MAX)
+
+// Not CFG_TUH_CDC: Adafruit_USBH_CDC (the Arduino wrapper CFG_TUH_CDC=1
+// pulls in) subclasses HardwareSerial with a default constructor that
+// STM32duino's HardwareSerial doesn't have (it requires pin arguments) --
+// untested combination upstream. usb-host-msc only needs CFG_TUH_MSC.
+
+#endif // CFG_TUH_ENABLED
 
 #endif
