diff --git a/src/arduino/ports/esp32/tusb_config_esp32.h b/src/arduino/ports/esp32/tusb_config_esp32.h
index b3fa1461..013951bc 100644
--- a/src/arduino/ports/esp32/tusb_config_esp32.h
+++ b/src/arduino/ports/esp32/tusb_config_esp32.h
@@ -141,9 +141,22 @@ extern "C" {
 // Host Configuration
 //--------------------------------------------------------------------
 
-// Enable host stack with MAX3421E (host shield)
 #define CFG_TUH_ENABLED 1
+
+// S2/S3/P4 have a native USB-OTG (DWC2) peripheral -- use it directly by
+// default. Every other ESP32 variant (classic ESP32, C3, C6, H2, ...) has
+// no USB peripheral at all, so host mode there only works via an external
+// MAX3421E host-shield chip wired over SPI (see usb-host-msc's
+// extras/ESP32_NATIVE.md). Override with -DCFG_TUH_MAX3421=1 to force
+// MAX3421E mode on a native-OTG chip too (e.g. you actually wired one up).
+#ifndef CFG_TUH_MAX3421
+#if CONFIG_IDF_TARGET_ESP32S2 || CONFIG_IDF_TARGET_ESP32S3 ||                 \
+    CONFIG_IDF_TARGET_ESP32P4
+#define CFG_TUH_MAX3421 0
+#else
 #define CFG_TUH_MAX3421 1
+#endif
+#endif
 #define CFG_TUH_MAX_SPEED OPT_MODE_FULL_SPEED
 
 #ifndef CFG_TUH_MAX3421_ENDPOINT_TOTAL
